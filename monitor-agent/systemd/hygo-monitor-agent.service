[Unit]
Description=Hygo Monitor Agent
Documentation=https://github.com/hygo/monitor-agent
After=network.target

[Service]
Type=simple
User=hygo
Group=hygo
WorkingDirectory=/opt/hygo-monitor-agent
ExecStart=/usr/bin/node /opt/hygo-monitor-agent/dist/index.js
Restart=always
RestartSec=10

# Environment
Environment="NODE_ENV=production"
EnvironmentFile=/opt/hygo-monitor-agent/.env

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hygo-monitor-agent/logs

# Resource limits
LimitNOFILE=65536
MemoryLimit=1G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hygo-monitor-agent

[Install]
WantedBy=multi-user.target