# Copy to /etc/hygo-backup.env on the Hygo application host and chmod 600.

BACKUP_HOST=hygo

POSTGRES_CONTAINER=postgres
POSTGRES_DATABASE=analytics
POSTGRES_STAGING_ROOT=/var/backups/hygo/postgres
POSTGRES_RCLONE_REMOTES=backblaze:hygo-backups/hygo/postgres

# No ClickHouse backup is configured here. The backend uses the standalone
# ClickHouse host rather than this host's effectively empty local volume.

# POSTGRES_SUCCESS_URL=
# POSTGRES_FAILURE_URL=
