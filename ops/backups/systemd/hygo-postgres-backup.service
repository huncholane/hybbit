[Unit]
Description=Hygo native PostgreSQL backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=BACKUP_CONFIG=/etc/hygo-backup.env
ExecStart=/opt/hygo-backups/bin/backup-postgres.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

